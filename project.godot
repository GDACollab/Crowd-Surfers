[layer_names]

3d_physics/layer_2="Player"
3d_physics/layer_4="4"
3d_physics/layer_8="8"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/speculative_contact_distance=0.01
jolt_physics_3d/simulation/bounce_velocity_threshold=50.0
jolt_physics_3d/simulation/body_pair_contact_cache_distance_threshold=0.01
jolt_physics_3d/simulation/body_pair_contact_cache_angle_threshold=0.08726646259971647
jolt_physics_3d/motion_queries/use_enhanced_internal_edge_removal=false
3d/solver/solver_iterations=10
3d/solver/contact_recycle_radius=0.1
3d/solver/contact_max_allowed_penetration=0.1
3d/solver/default_contact_bias=0.0
3d/vsync/vsync_mode=1

[rendering]

anti_aliasing/quality/msaa_3d=2
occlusion_culling/use_occlusion_culling=true

