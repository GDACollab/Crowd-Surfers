; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://Assets/Sound_Banks"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Crowd Surfers V1.0"
run/main_scene="uid://7uehf4aws4ii"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
run/max_fps=60
config/icon="res://Assets/Art/icon.svg"

[autoload]

FmodManager="*res://addons/fmod/FmodManager.gd"
PlayerSpawn="*res://Scripts/Singletons/Player_Spawn.gd"
SceneFadeTransition="*res://Scripts/Singletons/scene_fade_transition.tscn"
Settings="*res://Scripts/Singletons/settings.gd"
Inky="*res://Scripts/Singletons/InkyHandler.cs"
SaveDataManager="*res://Scripts/Singletons/save_data_manager.gd"
Story="*res://Scripts/Singletons/story_tracker.gd"
Audio="*res://Scripts/Singletons/audio_manager.tscn"

[debug]

shapes/navigation/3d/geometry_face_color=Color(0.5019608, 1, 1, 1)
shapes/navigation/3d/geometry_face_disabled_color=Color(0.5019608, 0.5019608, 0.5019608, 0.5568628)
shapes/collision/shape_color=Color(0, 0.6, 0.69803923, 1)
shapes/collision/contact_color=Color(1, 0.2, 0.101960786, 1)

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/size/borderless=true
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Crowd Surfers V1.0"

[editor_plugins]

enabled=PackedStringArray("res://addons/GPUTrail/plugin.cfg", "res://addons/GodotInk/plugin.cfg", "res://addons/fmod/plugin.cfg")

[global_group]

Concrete="The ground component which will likely be streets and sidewalks will be made of concrete "
Metal="Obstacles such as vehicles, trashcans, smacking into street lamps/poles, firehydrants, cars, etc"
Crowd=""
Vehicles=""
Grass=""
Cullable="Can be culled by staticbody culling area"

[gui]

common/snap_controls_to_pixels=false
theme/custom_font="uid://dm26d870h8e4d"

